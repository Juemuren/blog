{
  "files.associations": {
    ".autocorrectrc": "yaml"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.*_cache": true
  },
  "explorer.fileNesting.patterns": {
    ".markdownlint.yaml": ".autocorrectrc, .cspell.yaml, .ltex.json, .typos.toml",
    "hugo.yaml": ".hugo_build.lock",
    ".gitignore": ".git*",
    "*.md": "$(capture).*.md, $(capture)-*.svg"
  },
  "Lua.diagnostics.globals": ["PANDOC_STATE", "pandoc"],
  "ltex.language": "zh-CN",
  "ltex.dictionary": {
    "zh-CN": [":../.ltex/dictionary.zh-CN.txt"]
  },
  "ltex.disabledRules": {
    "zh-CN": [":../.ltex/disabledRules.zh-CN.txt"]
  },
  "ltex.hiddenFalsePositives": {
    "zh-CN": [":../.ltex/hiddenFalsePositives.zh-CN.jsonl"]
  }
}
