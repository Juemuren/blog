{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Convert Math Delimiters in Markdown",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/content/convert-math-delimiters.py",
        "${relativeFile}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    },
    {
      "label": "Build the HTML",
      "type": "process",
      "command": "just",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "hugo",
        "source": "hugo",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(ERROR|WARN|INFO)\\s+(.*?\"([^\"]+):(\\d+):(\\d+)\".*)$",
          "severity": 1,
          "message": 2,
          "file": 3,
          "line": 4,
          "column": 5
        }
      },
      "presentation": {
        "reveal": "always",
        "revealProblems": "onProblem",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Start the Dev Server",
      "type": "shell",
      "command": "just",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Web Server is available at.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start the Preview Server",
      "type": "shell",
      "command": "just",
      "args": ["preview"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Available at.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
